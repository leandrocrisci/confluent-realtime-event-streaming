# Copie para .env e preencha. O .env nunca vai para o repositório.

# Confluent Cloud: ambiente e cluster (usados pelo setup.sh e pelo teardown.sh)
CONFLUENT_ENVIRONMENT_ID=env-xxxxxx
CONFLUENT_CLUSTER_ID=lkc-xxxxxx

# Conta de serviço do produtor (usada pelo conector em connectors/cdc.json)
SA_PRODUCER_ID=sa-xxxxxx

# Cluster Kafka: endpoint e chave de API do produtor (usados pelo producer.py)
CONFLUENT_BOOTSTRAP_SERVER=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=

# Schema Registry: endpoint e chave de API
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=

# Neon (Postgres) usado pelo conector CDC
NEON_HOST=
NEON_DB=confluentdb
CDC_USER=
CDC_PASSWORD=
